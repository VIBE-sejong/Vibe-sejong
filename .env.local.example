# Supabase project settings (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Session signing secret (generate: openssl rand -base64 32)
SESSION_SECRET=replace-with-a-long-random-string

# Optional: override the storage bucket names
SUPABASE_STORAGE_BUCKET=activity-images
SUPABASE_PROFILE_BUCKET=profile-images

# Gemini API key for the landing page chatbot (get one free: https://aistudio.google.com/apikey)
GEMINI_API_KEY=your-gemini-api-key-here
# Optional: override the model (defaults to gemini-flash-lite-latest)
GEMINI_MODEL=gemini-flash-lite-latest
